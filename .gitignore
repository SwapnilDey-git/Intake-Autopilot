storage/
# sample client docs / spec binaries (kept on disk, off history)
reference/
# reference test PDFs used for model comparison
testdoc/

# === Python ===
**/__pycache__/
*.pyc
*.pyo
.venv/
venv/

# === Node / Next.js (dashboard) ===
dashboard/node_modules/
dashboard/.next/
dashboard/out/
node_modules/


    {
      "id": "build-case-payload-001",
      "name": "Build Case Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -224,
        752
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Build ONE /api/intake/case payload per Gmail message. Each email arrives as a\n// single item carrying its attachments as binary keys (attachment_0, attachment_1,\n// ...). We base64 every attachment and hand the whole set to the backend, which\n// classifies them, files supporting docs, and extracts ONLY the primary tax form\n// (multi-file case grouping, 2026-08-19). Replaces the old per-attachment\n// Split -> Loop -> Call AI fan-out (and the label nodes that blocked intake).\nconst out = [];\nconst items = $input.all();\nfor (let i = 0; i < items.length; i++) {\n  const j = items[i].json || {};\n  const bin = items[i].binary || {};\n  const files = [];\n  for (const key of Object.keys(bin)) {\n    const meta = bin[key] || {};\n    const buff = await this.helpers.getBinaryDataBuffer(i, key);\n    files.push({\n      filename: meta.fileName || key,\n      mime: meta.mimeType || null,\n      content_base64: buff.toString('base64'),\n    });\n  }\n  let sender = j.from || null;\n  if (sender && typeof sender === 'object') sender = sender.value || sender.text || null;\n  out.push({ json: {\n    source: 'gmail',\n    external_ref: j.id || j.messageId || null,\n    sender: sender,\n    subject: j.subject || null,\n    files,\n  }});\n}\nreturn out;\n"
      }
    },
    {
      "id": "ingest-case-gmail-001",
      "name": "Ingest Case (Gmail)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        96,
        752
      ],
      "parameters": {
        "method": "POST",
        "url": "http://intake-backend:8080/api/intake/case",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 120000
        }
      }
    }

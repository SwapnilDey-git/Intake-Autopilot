    {
      "parameters": {
        "jsCode": "// WhatsApp sends the attached photo/PDF as a media ID, not inline bytes\n// (unlike Gmail's downloadAttachments) -- normalize the fields the rest of\n// this branch needs (media_id to fetch, a usable filename, the sender) before\n// the two chained Graph API calls that actually retrieve the file. Only\n// image/document messages reach this node -- status-update webhooks and text\n// messages were already filtered out upstream.\nconst value = $input.first().json.body.entry[0].changes[0].value;\nconst message = value.messages[0];\nconst mediaType = message.type; // 'image' or 'document'\nconst media = message[mediaType];\nconst filename = media.filename || `${message.id}.${mediaType === 'image' ? 'jpg' : 'bin'}`;\nreturn [{\n  json: {\n    media_id: media.id,\n    mime_type: media.mime_type,\n    filename,\n    sender: message.from,\n  },\n}];"
      },
      "id": "aed91d32-ddec-48fa-9582-2be0d0428c63",
      "name": "Extract Media Info (WhatsApp)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -160,
        2336
      ]
    },
    {
      "parameters": {
        "url": "=https://graph.facebook.com/v21.0/{{ $json.media_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "f99859f9-aff3-45b4-9ec9-2eac18876e05",
      "name": "Get Media URL (WhatsApp)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
